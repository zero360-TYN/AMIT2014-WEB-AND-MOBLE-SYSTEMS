@model Assignment.Models.ServiceCategoryCreateViewModel

@{
    ViewBag.Title = "Create Service Category";
}

<h2>Create Service Category</h2>

<hr />
<form id="createServiceCategoryForm" asp-action="CreateServiceCategory" method="post">
    <div asp-validation-summary="ModelOnly"></div>
    <div>
        <label asp-for="Name"></label>
        <input asp-for="Name" />
        <span asp-validation-for="Name"></span>
    </div>
    <div>
        <label asp-for="Description"></label>
        <input asp-for="Description" />
        <span asp-validation-for="Description"></span>
    </div>
    <br />
    <div>
        <button id="createBtn" type="submit">Create</button>
        <a asp-action="ServiceCategoryList">Back to Category List</a> |
        <a asp-action="Create">Create Service</a> |
        <a asp-action="List">Back to Service List</a> |
        <a asp-action="Index">Back to Dashboard</a>
    </div>
</form>

@section foot {
    <script>
        const form = document.getElementById('createServiceCategoryForm');
        const createBtn = document.getElementById('createBtn');

        createBtn.addEventListener('click', function(event) {
            event.preventDefault();
            if (!$(form).valid()) {
                return;
            }

            Swal.fire({
                title: 'Are you sure?',
                text: "You are about to create a new service category.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33',
                confirmButtonText: 'Yes, create it!'
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}
