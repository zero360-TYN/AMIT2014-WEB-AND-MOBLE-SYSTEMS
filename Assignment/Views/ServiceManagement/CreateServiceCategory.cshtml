@model Assignment.Models.ServiceCategoryCreateViewModel

@{
    ViewBag.Title = "Create Service Category";
}

<link rel="stylesheet" href="~/css/ServiceManagement/Form.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Define New Category
    </h2>
</div>

<div class="pk-form-panel">
    <form id="createCategoryForm" asp-action="CreateServiceCategory" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>
        
        <div class="pk-form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="e.g. Grooming" />
            <span asp-validation-for="Name" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" placeholder="Details about this category..."></textarea>
            <span asp-validation-for="Description" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-actions-bar">
            <button id="createBtn" type="submit" class="pk-btn-submit">Create Category</button>
            <a asp-action="ServiceCategoryList" class="pk-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        const form = document.getElementById('createCategoryForm');
        const createBtn = document.getElementById('createBtn');

        createBtn.addEventListener('click', function(event) {
            event.preventDefault();
            if (!$(form).valid()) {
                return;
            }

            Swal.fire({
                title: 'Confirm Creation',
                text: "You are about to define a new service category.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--pk-blue-500)',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, create it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}