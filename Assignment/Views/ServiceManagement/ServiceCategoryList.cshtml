@model TableListingViewModel

@{
    ViewBag.Title = "Service Category List";
}

<link rel="stylesheet" href="~/css/ServiceManagement/List.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Service Categories
    </h2>
    <div class="pk-header-actions">
        <a asp-action="CreateServiceCategory">+ Create New Category</a>
        <a asp-action="List">View Services</a>
    </div>
</div>

<div style="margin-bottom: 24px;">
    <partial name="_AjaxSearch" model='new AjaxSearchViewModel {
        Fields = new() {
            { nameof(ServiceCategory.Id), "Category ID" },
            { nameof(ServiceCategory.Name), "Category Name" },
            { nameof(ServiceCategory.Description), "Description" }
        }
    }' />
</div>

<div id="table-container">
    @Html.Partial("_TableList", Model)
</div>

<a asp-action="Index" class="pk-btn-outline">Back to Dashboard</a>