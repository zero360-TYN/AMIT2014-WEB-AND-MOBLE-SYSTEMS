@model TableListingViewModel

@{
    ViewBag.Title = "Service List";
}

<link rel="stylesheet" href="~/css/ServiceManagement/List.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Treatment Services
    </h2>
    <div class="pk-header-actions">
        <a asp-action="ServiceCategoryList">View Categories</a>
    </div>
</div>

<div style="margin-bottom: 24px;">
    <partial name="_AjaxSearch" model='new AjaxSearchViewModel {
        Fields = new() {
            { nameof(Service.Id), "Service ID" },
            { nameof(Service.Name), "Service Name" },
            { $"{nameof(Service.ServiceCategory)}.{nameof(ServiceCategory.Name)}", "Category" },
            { nameof(Service.Price), "Price" },
            { nameof(Service.DurationMinutes), "Duration" }
        }
    }' />
</div>

<div id="table-container">
    @Html.Partial("_TableList", Model)
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" id="deleteServiceId" />
</form>

<a asp-action="Index" class="pk-btn-outline">Back to Dashboard</a>

@section foot {
    <script>
        const deleteForm = document.getElementById('deleteForm');
        const deleteServiceId = document.getElementById('deleteServiceId');

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-delete');
            if (!btn) return;

            e.preventDefault();
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');

            Swal.fire({
                title: 'Confirm Deletion',
                text: 'You are about to delete Service "' + name + '". This action cannot be undone.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: 'var(--pk-blue-500)',
                confirmButtonText: 'Yes, delete it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteServiceId.value = id;
                    deleteForm.submit();
                }
            });
        });
    </script>
}