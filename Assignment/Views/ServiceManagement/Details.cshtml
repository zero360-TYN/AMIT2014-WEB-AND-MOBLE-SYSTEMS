@model Assignment.Models.ServiceDetailsViewModel

@{
    ViewBag.Title = "Service Details";
}

<link rel="stylesheet" href="~/css/ServiceManagement/Details.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Service Details
    </h2>
</div>

<div class="pk-details-card">
    <table class="simple-table">
        <tbody>
            <tr>
                <th>Service ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Service Name</th>
                <td><strong>@Model.Name</strong></td>
            </tr>
            <tr>
                <th>Description</th>
                <td>@(string.IsNullOrWhiteSpace(Model.Description) ? "N/A" : Model.Description)</td>
            </tr>
            <tr>
                <th>Price</th>
                <td><strong style="color: #10b981;">@Model.Price.ToString("C", new System.Globalization.CultureInfo("en-MY"))</strong></td>
            </tr>
            <tr>
                <th>Duration</th>
                <td>@Model.DurationMinutes minutes</td>
            </tr>
            <tr>
                <th>Service Category</th>
                <td><span style="color: var(--pk-blue-600); font-weight: 600;">@Model.ServiceCategoryName</span></td>
            </tr>
            <tr>
                <th>Created At</th>
                <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        </tbody>
    </table>
    
    <div class="pk-actions-bar">
        <a asp-action="List" class="pk-btn-outline">Back to list</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="pk-btn-primary">Edit Service</a>
        <button type="button" id="deleteBtn" class="pk-btn-danger">Delete Service</button>
    </div>
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" value="@Model.Id" />
</form>

@section foot {
    <script>
        const deleteBtn = document.getElementById('deleteBtn');
        const deleteForm = document.getElementById('deleteForm');

        if (deleteBtn) {
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Confirm Deletion',
                    text: `You are about to delete Service "${@Html.Raw(Json.Serialize(Model.Name))}". This action cannot be undone.`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: 'var(--pk-blue-500)',
                    confirmButtonText: 'Yes, delete it!',
                    customClass: { popup: 'pk-swal-modal' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        deleteForm.submit();
                    }
                });
            });
        }
    </script>
}
