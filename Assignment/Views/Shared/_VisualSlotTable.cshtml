@model Assignment.Models.VisualSlotTableConfig
@using System.Text.Json

@{
    var config = Model ?? new Assignment.Models.VisualSlotTableConfig();
    var isWeek = config.ViewType == Assignment.Models.SlotViewType.Week;

    var eventsJson = config.Events != null 
        ? JsonSerializer.Serialize(config.Events.Select(e => new {
            id = e.Id,
            text = e.Text,
            start = e.Start.ToString("yyyy-MM-ddTHH:mm:ss"),
            end = e.End.ToString("yyyy-MM-ddTHH:mm:ss"),
            resource = e.Resource,
            backColor = string.IsNullOrEmpty(e.BackColor) ? "#3788d8" : e.BackColor,
            fontColor = "#ffffff",
            status = e.Status,
            data = e.Data
        })) 
        : "[]";

    var resourcesJson = (!isWeek && config.Resources != null)
        ? JsonSerializer.Serialize(config.Resources.Select(r => new { id = r.Id, name = r.Name }))
        : "[]";
}

<div class="visual-slot-table-component card shadow-sm mb-3" id="@(config.Id)_wrapper">
    @if (config.ShowNavigation)
    {
        <div class="card-header bg-light d-flex flex-wrap justify-content-between align-items-center gap-2 py-2">
            <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-secondary" id="@(config.Id)_prevBtn">&lt; Prev</button>
                <button type="button" class="btn btn-outline-secondary" id="@(config.Id)_todayBtn">Today</button>
                <button type="button" class="btn btn-outline-secondary" id="@(config.Id)_nextBtn">Next &gt;</button>
            </div>

            <div class="fw-bold fs-6 text-primary" id="@(config.Id)_title"></div>

            <div class="d-flex align-items-center gap-2 small">
                @if (config.IsReadOnly)
                {
                    <span class="badge bg-secondary">Mode: Read-Only</span>
                    <span class="d-inline-flex align-items-center me-1">
                        <span class="d-inline-block rounded me-1" style="width: 12px; height: 12px; background-color: #3788d8;"></span>
                        Scheduled
                    </span>
                }
                else
                {
                    <span class="badge bg-success">Mode: Select Slot</span>
                    <span class="d-inline-flex align-items-center me-1">
                        <span class="d-inline-block rounded me-1" style="width: 12px; height: 12px; background-color: #3788d8;"></span>
                        Occupied
                    </span>
                    <span class="d-inline-flex align-items-center">
                        <span class="d-inline-block rounded me-1" style="width: 12px; height: 12px; background-color: #198754;"></span>
                        Selected
                    </span>
                }
            </div>
        </div>
    }

    <div class="card-body p-2">
        <div id="@config.Id" class="daypilot-container"></div>
        @if (!string.IsNullOrEmpty(config.EventsUrl))
        {
            <form id="@(config.Id)_ajaxForm" data-ajax="true" data-ajax-method="GET" data-ajax-url="@config.EventsUrl"
                  data-ajax-success="window['slotTable_@(config.Id)'].handleEventsLoaded"
                  data-ajax-failure="window['slotTable_@(config.Id)'].handleEventsFailed" style="display:none;">
                <input type="hidden" name="start" id="@(config.Id)_pStart" />
                <input type="hidden" name="end" id="@(config.Id)_pEnd" />
            </form>
        }
    </div>
</div>

<style>
    #@(config.Id)_wrapper .daypilot-container {
        border: 1px solid #dee2e6;
        border-radius: 4px;
        overflow: hidden;
    }
    #@(config.Id)_wrapper .calendar_default_event_inner,
    #@(config.Id)_wrapper .scheduler_default_event_inner {
        border-radius: 3px;
        padding: 2px 4px;
        font-size: 12px;
        box-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }
</style>

<script>
(function () {
    function initSlotTable() {
        const isWeek = @(isWeek ? "true" : "false");
        const isReadOnly = @(config.IsReadOnly ? "true" : "false");
        const stepDays = isWeek ? 7 : 1;
        const initialEvents = @Html.Raw(eventsJson);
        const columns = @Html.Raw(resourcesJson);

        const commonOptions = {
            startDate: new DayPilot.Date("@config.StartDate.ToString("yyyy-MM-dd")"),
            businessBeginsHour: @config.BusinessBeginsHour,
            businessEndsHour: @config.BusinessEndsHour,
            cellDuration: @config.CellDuration,
            events: { list: initialEvents },
            timeRangeSelectedHandling: isReadOnly ? "Disabled" : "Enabled",
            eventClickHandling: "Enabled",
            eventMoveHandling: "Disabled",
            eventResizeHandling: "Disabled",
            eventDeleteHandling: "Disabled",

            onTimeRangeSelected: function (args) {
                if (isReadOnly) return dp.clearSelection();

                // Collision detection against existing events
                const hasConflict = dp.events.list.some(ev => {
                    if (ev.id === "temp-selected-slot") return false;
                    const sameResource = isWeek || !ev.resource || ev.resource === args.resource;
                    return sameResource && (args.start < new DayPilot.Date(ev.end) && args.end > new DayPilot.Date(ev.start));
                });

                if (hasConflict) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Slot Unavailable',
                        text: 'This time slot is already occupied. Please choose another slot.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                    return dp.clearSelection();
                }

                // Render selected slot badge
                dp.events.remove("temp-selected-slot");
                dp.events.add({
                    id: "temp-selected-slot",
                    start: args.start,
                    end: args.end,
                    resource: args.resource,
                    text: "✓ Selected Slot",
                    backColor: "#198754",
                    fontColor: "#ffffff"
                });
                dp.clearSelection();

                // Auto-fill target form inputs
                const startIso = args.start.toString("yyyy-MM-ddTHH:mm:ss");
                const endIso = args.end.toString("yyyy-MM-ddTHH:mm:ss");
                const sync = (sel, val) => { if (sel) { const el = document.querySelector(sel); if (el) el.value = val; } };
                sync("@config.TargetStartInput", startIso);
                sync("@config.TargetEndInput", endIso);
                sync("@config.TargetResourceInput", args.resource || "");

                // Dispatch callbacks and DOM custom event
                const detail = { start: args.start.value, end: args.end.value, formattedStart: startIso, formattedEnd: endIso, resource: args.resource || null };
                const cb = "@config.OnSlotSelect";
                if (cb && typeof window[cb] === "function") window[cb](detail);
                document.getElementById("@(config.Id)_wrapper")?.dispatchEvent(new CustomEvent("slotSelected", { detail, bubbles: true }));
            },

            onEventClick: function (args) {
                if (args.e.id() === "temp-selected-slot") return;

                const cb = "@config.OnEventClick";
                if (cb && typeof window[cb] === "function") return window[cb](args.e.data);

                // Auto-fallback to global reusable modal if present
                if (typeof window.showBookingDetailModal === "function") {
                    return window.showBookingDetailModal(args.e.data);
                }

                Swal.fire({
                    title: args.e.text() || 'Event Details',
                    html: `<div class="text-start">
                        <p class="mb-1"><strong>Time:</strong> ${args.e.start().toString("yyyy-MM-dd HH:mm")} - ${args.e.end().toString("HH:mm")}</p>
                        <p class="mb-1"><strong>Status:</strong> <span class="badge bg-info text-dark">${args.e.data.status || 'Scheduled'}</span></p>
                    </div>`,
                    icon: 'info',
                    confirmButtonColor: '#3085d6'
                });
            }
        };

        // Use DayPilot.Calendar for Week view (vertical time axis)
        // Use DayPilot.Scheduler for Resources view (horizontal time axis, vertical resource rows)
        let dp;
        if (isWeek) {
            dp = new DayPilot.Calendar("@config.Id", {
                ...commonOptions,
                viewType: "Week",
                dayBeginsHour: @config.BusinessBeginsHour,
                dayEndsHour: @config.BusinessEndsHour
            });
        } else {
            dp = new DayPilot.Scheduler("@config.Id", {
                ...commonOptions,
                days: 1,
                scale: "Hour",
                cellWidth: 60,
                showNonBusiness: false,
                resources: columns
            });
        }

        // Updates toolbar title display
        function updateTitle() {
            const el = document.getElementById("@(config.Id)_title");
            if (!el) return;
            el.textContent = isWeek
                ? `${dp.visibleStart().toString("MMM d, yyyy")} - ${dp.visibleEnd().addDays(-1).toString("MMM d, yyyy")}`
                : dp.startDate.toString("dddd, MMM d, yyyy");
        }

        // Loads events via Unobtrusive AJAX
        function loadEvents() {
            const form = document.getElementById("@(config.Id)_ajaxForm");
            if (!form) return;
            document.getElementById("@(config.Id)_pStart").value = dp.visibleStart().toString("yyyy-MM-dd");
            document.getElementById("@(config.Id)_pEnd").value = dp.visibleEnd().toString("yyyy-MM-dd");
            $(form).trigger("submit");
        }

        // Consolidated navigation helper
        function navigate(days) {
            dp.startDate = days === 0 ? DayPilot.Date.today() : dp.startDate.addDays(days);
            dp.update();
            updateTitle();
            loadEvents();
        }

        // Global handle registration
        window["slotTable_@config.Id"] = {
            dp: dp,
            reload: loadEvents,
            setDate: function (dateStr) {
                dp.startDate = new DayPilot.Date(dateStr);
                dp.update();
                updateTitle();
                loadEvents();
            },
            getSelectedSlot: () => dp.events.find("temp-selected-slot")?.data || null,
            handleEventsLoaded: function (data) {
                const list = typeof data === "string" ? JSON.parse(data) : data;
                if (Array.isArray(list)) {
                    dp.events.list = list.map(i => ({
                        id: i.id || i.Id,
                        text: i.text || i.Text,
                        start: i.start || i.Start,
                        end: i.end || i.End,
                        resource: i.resource || i.Resource,
                        backColor: i.backColor || i.BackColor || "#3788d8",
                        fontColor: "#ffffff",
                        status: i.status || i.Status,
                        data: i.data || i.Data
                    }));
                    dp.update();
                }
            },
            handleEventsFailed: (xhr, s, err) => console.error("SlotTable AJAX error:", s, err)
        };

        // Bind events and initialize
        dp.init();
        updateTitle();
        document.getElementById("@(config.Id)_prevBtn")?.addEventListener("click", () => navigate(-stepDays));
        document.getElementById("@(config.Id)_todayBtn")?.addEventListener("click", () => navigate(0));
        document.getElementById("@(config.Id)_nextBtn")?.addEventListener("click", () => navigate(stepDays));
    }

    // Wait until DayPilot is ready before initialization
    (function check() {
        if (window.DayPilot) initSlotTable();
        else setTimeout(check, 50);
    })();
})();
</script>
