@* Reusable Booking Detail Modal Component based on SweetAlert2 *@
<link rel="stylesheet" href="~/css/PartialView/_BookingDetailModal.css" asp-append-version="true" />

<script>
    window.showBookingDetailModal = function (eventOrData) {
        if (!eventOrData) return;

        const raw = eventOrData.data || eventOrData;
        const bookingId = raw.bookingId || eventOrData.id || "N/A";
        const status = (raw.status || eventOrData.status || "N/A").toLowerCase();

        let badgeClass = "pk-badge ";
        switch(status) {
            case "confirmed": badgeClass += "pk-badge-confirmed"; break;
            case "pending": badgeClass += "pk-badge-pending"; break;
            case "completed": badgeClass += "pk-badge-completed"; break;
            case "cancelled": badgeClass += "pk-badge-cancelled"; break;
            default: badgeClass += "bg-secondary text-white"; break;
        }

        const rawStart = raw.start || eventOrData.start || "";
        const rawEnd = raw.end || eventOrData.end || "";
        const startStr = rawStart ? rawStart.replace("T", " ").substring(0, 16) : "N/A";
        const endStr = rawEnd ? rawEnd.replace("T", " ").substring(11, 16) : "N/A";

        Swal.fire({
            title: `Booking #${bookingId}`,
            customClass: {
                popup: 'pk-swal-modal',
                title: 'pk-swal-title',
                confirmButton: 'pk-btn-confirm',
                cancelButton: 'pk-btn-cancel'
            },
            html: `
                <div style="text-align: center; margin-bottom: 16px;">
                    <span class="${badgeClass}">${status}</span>
                </div>
                <table class="pk-swal-table" style="text-align: left;">
                    <tbody>
                        ${raw.roomNumber ? `
                        <tr>
                            <th>Room</th>
                            <td><strong>${raw.roomNumber}</strong></td>
                        </tr>` : ''}
                        <tr>
                            <th>Customer</th>
                            <td>${raw.customerName || 'N/A'} ${raw.customerEmail ? `<br><small style="color: #64748b;">${raw.customerEmail}</small>` : ''}</td>
                        </tr>
                        <tr>
                            <th>Pokemon</th>
                            <td><strong>${raw.pokemonName || 'N/A'}</strong></td>
                        </tr>
                        <tr>
                            <th>Service</th>
                            <td>${raw.serviceName || eventOrData.text || 'N/A'}</td>
                        </tr>
                        ${raw.staffName ? `
                        <tr>
                            <th>Assigned Staff</th>
                            <td>${raw.staffName}</td>
                        </tr>` : ''}
                        <tr>
                            <th>Schedule</th>
                            <td>${startStr} ~ ${endStr}</td>
                        </tr>
                        <tr>
                            <th>Total Price</th>
                            <td><strong style="color: #0284c7;">${raw.totalPrice || 'N/A'}</strong></td>
                        </tr>
                    </tbody>
                </table>
            `,
            showCancelButton: true,
            confirmButtonText: 'View Full Details',
            cancelButtonText: 'Close',
            buttonsStyling: false
        }).then((result) => {
            if (result.isConfirmed && bookingId !== "N/A") {
                window.location.href = `/BookingManagement/Details/${bookingId}`;
            }
        });
    };
</script>
