@{
    ViewBag.Title = "Booking Entry";
}

<link rel="stylesheet" href="~/css/Booking/Index.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Booking System
    </h2>
</div>

<div class="pk-welcome-card">
    <h3 style="font-family: var(--pk-font-serif); color: var(--pk-charcoal-dark); margin-top: 0;">Welcome to the Pokémon Center</h3>
    <p style="color: var(--pk-text-main); font-size: 1.1rem;">Please select an action to manage or schedule a healing session or facility booking.</p>
    
    <div class="pk-action-links">
        <a asp-action="Booking" class="pk-btn-primary">Start a New Booking</a>
        <a asp-action="MyBookings" class="pk-btn-outline">My Bookings</a>
        <a asp-controller="Home" asp-action="Index" class="pk-btn-outline" style="border-color: #cbd5e1; color: #475569 !important;">Back to Home</a>
    </div>
</div>
