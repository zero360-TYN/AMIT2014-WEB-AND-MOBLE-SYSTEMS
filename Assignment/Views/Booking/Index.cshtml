@model Assignment.Models.MemberBookingViewModel
@using Assignment.Models
@{
    ViewBag.Title = "Step-by-Step Booking";
    var categories = ViewBag.ServiceCategories as List<ServiceCategory> ?? new List<ServiceCategory>();
    var services = ViewBag.AllServices as List<Service> ?? new List<Service>();
    var staffs = ViewBag.StaffList as IEnumerable<dynamic> ?? new List<dynamic>();
}

<h2>Member Booking (Step by Step)</h2>
<div>
    <a asp-action="MyBookings">My Bookings</a> |
    <a asp-controller="Home" asp-action="Index">Home</a>
</div>
<hr />

<!-- Step Indicator -->
<div id="stepIndicator" style="margin-bottom: 15px;">
    <span id="stepLabel1"><strong>Step 1: Service</strong></span> &gt;
    <span id="stepLabel2">Step 2: Room</span> &gt;
    <span id="stepLabel3">Step 3: Schedule &amp; Staff</span> &gt;
    <span id="stepLabel4">Step 4: Pokémon Info</span> &gt;
    <span id="stepLabel5">Step 5: Review &amp; Confirm</span>
</div>
<hr />

<form id="memberBookingForm" asp-action="Create" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly"></div>

    <input type="hidden" asp-for="ServiceId" id="selectedServiceId" />
    <input type="hidden" asp-for="RoomId" id="selectedRoomId" />
    <input type="hidden" asp-for="StartTime" id="selectedStartTime" value="@Model.StartTime.ToString("yyyy-MM-ddTHH:mm")" />

    <!-- STEP 1: SERVICE -->
    <div id="panel1" class="wizard-panel">
        <h3>Step 1: Choose a Service</h3>

        <div>
            <label for="categoryFilter">Filter by Category:</label>
            <select id="categoryFilter">
                <option value="all">-- All Categories --</option>
                @foreach (var cat in categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>
        </div>
        <br />

        <table class="simple-table" id="servicesTable">
            <thead>
                <tr>
                    <th>Select</th>
                    <th>Category</th>
                    <th>Service Name</th>
                    <th>Description</th>
                    <th>Duration</th>
                    <th>Price</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in services)
                {
                    <tr class="service-row" data-category="@s.ServiceCategoryId">
                        <td>
                            <input type="radio" name="serviceRadio" value="@s.Id"
                                   data-name="@s.Name"
                                   data-price="@s.Price"
                                   data-duration="@s.DurationMinutes"
                                   data-categoryname="@s.ServiceCategory?.Name"
                                   @(Model.ServiceId == s.Id ? "checked" : "") />
                        </td>
                        <td>@s.ServiceCategory?.Name</td>
                        <td><strong>@s.Name</strong></td>
                        <td>@s.Description</td>
                        <td>@s.DurationMinutes mins</td>
                        <td>RM @s.Price.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
        <br />

        <div>
            <button type="button" id="btnNext1">Next: Select Room &gt;</button>
        </div>
    </div>

    <!-- STEP 2: ROOM -->
    <div id="panel2" class="wizard-panel" style="display: none;">
        <h3>Step 2: Choose Room</h3>
        <p>Rooms available under the selected service category:</p>

        <div id="roomLoadingMsg" style="display: none;">Loading available rooms...</div>

        <table class="simple-table" id="roomsTable">
            <thead>
                <tr>
                    <th>Select</th>
                    <th>Room Number</th>
                    <th>Room Type</th>
                    <th>Description</th>
                    <th>Facility Fee</th>
                </tr>
            </thead>
            <tbody id="roomTbody">
                <!-- Dynamically populated via AJAX -->
            </tbody>
        </table>
        <br />

        <div>
            <button type="button" id="btnPrev2">&lt; Back to Service</button>
            <button type="button" id="btnNext2">Next: Schedule &amp; Staff &gt;</button>
        </div>
    </div>

    <!-- STEP 3: SCHEDULE & STAFF -->
    <div id="panel3" class="wizard-panel" style="display: none;">
        <h3>Step 3: Pick Schedule &amp; Staff</h3>

        <div>
            <label for="bookingDatePicker">Booking Date:</label>
            <input type="date" id="bookingDatePicker"
                   value="@DateTime.Today.AddDays(1).ToString("yyyy-MM-dd")"
                   min="@DateTime.Today.ToString("yyyy-MM-dd")" />
        </div>
        <br />

        <div>
            <label asp-for="StaffId">Assigned Staff:</label>
            <select asp-for="StaffId" id="staffSelector">
                <option value="">-- Any Available Staff (Auto-Assign) --</option>
                @foreach (var staff in staffs)
                {
                    <option value="@staff.Id">@staff.DisplayName</option>
                }
            </select>
        </div>
        <br />

        <div>
            <label>Available Time Slots (09:00 - 18:00):</label>
            <div id="slotStatusMsg">Checking slot availability...</div>
            <div id="slotListContainer" style="margin-top: 8px;"></div>
            <div id="selectedSlotNotice" style="margin-top: 8px; display: none;">
                <strong>Selected Time:</strong> <span id="selectedSlotText"></span>
            </div>
        </div>
        <br />

        <div>
            <button type="button" id="btnPrev3">&lt; Back to Rooms</button>
            <button type="button" id="btnNext3">Next: Pokémon Info &gt;</button>
        </div>
    </div>

    <!-- STEP 4: POKÉMON DETAILS -->
    <div id="panel4" class="wizard-panel" style="display: none;">
        <h3>Step 4: Pokémon Information</h3>

        <div>
            <label asp-for="PokemonName">Pokémon Name:</label>
            <input asp-for="PokemonName" id="pokemonNameInput" placeholder="e.g. Pikachu" />
            <span asp-validation-for="PokemonName"></span>
        </div>
        <br />

        <div>
            <label asp-for="Notes">Special Notes / Allergies:</label>
            <textarea asp-for="Notes" id="notesInput" rows="3" placeholder="Special requirements..."></textarea>
            <span asp-validation-for="Notes"></span>
        </div>
        <br />

        <div>
            <button type="button" id="btnPrev4">&lt; Back to Schedule</button>
            <button type="button" id="btnNext4">Next: Review &amp; Confirm &gt;</button>
        </div>
    </div>

    <!-- STEP 5: REVIEW & SUMMARY -->
    <div id="panel5" class="wizard-panel" style="display: none;">
        <h3>Step 5: Review &amp; Confirmation</h3>

        <table class="simple-table" style="max-width: 600px;">
            <tbody>
                <tr>
                    <th style="width: 35%;">Pokémon Name</th>
                    <td id="sumPokemonName">-</td>
                </tr>
                <tr>
                    <th>Service</th>
                    <td id="sumServiceName">-</td>
                </tr>
                <tr>
                    <th>Duration</th>
                    <td id="sumDuration">-</td>
                </tr>
                <tr>
                    <th>Room</th>
                    <td id="sumRoomName">-</td>
                </tr>
                <tr>
                    <th>Staff</th>
                    <td id="sumStaffName">-</td>
                </tr>
                <tr>
                    <th>Schedule</th>
                    <td id="sumSchedule">-</td>
                </tr>
                <tr>
                    <th>Special Notes</th>
                    <td id="sumNotes">-</td>
                </tr>
                <tr>
                    <th>Service Fee</th>
                    <td id="sumServicePrice">RM 0.00</td>
                </tr>
                <tr>
                    <th>Room Facility Fee</th>
                    <td id="sumRoomPrice">RM 0.00</td>
                </tr>
                <tr>
                    <th>Total Price</th>
                    <td><strong id="sumTotalPrice">RM 0.00</strong></td>
                </tr>
            </tbody>
        </table>
        <br />

        <p>Please review your booking details above before continuing to payment.</p>

        <div>
            <button type="button" id="btnPrev5">&lt; Back</button>
            <button type="submit" id="btnSubmitBooking">Confirm Booking &amp; Continue to Payment</button>
        </div>
    </div>
</form>

@section foot {
    <script>
        let currentStep = 1;
        const totalSteps = 5;

        let selectedService = null;
        let selectedRoom = null;
        let selectedSlot = null;

        const form = document.getElementById('memberBookingForm');
        const selectedServiceIdInput = document.getElementById('selectedServiceId');
        const selectedRoomIdInput = document.getElementById('selectedRoomId');
        const selectedStartTimeInput = document.getElementById('selectedStartTime');
        const bookingDatePicker = document.getElementById('bookingDatePicker');
        const staffSelector = document.getElementById('staffSelector');
        const pokemonNameInput = document.getElementById('pokemonNameInput');
        const notesInput = document.getElementById('notesInput');
        const categoryFilter = document.getElementById('categoryFilter');

        function updateStepIndicator(step) {
            for (let i = 1; i <= totalSteps; i++) {
                const label = document.getElementById(`stepLabel${i}`);
                if (!label) continue;
                if (i === step) {
                    label.innerHTML = `<strong>Step ${i}: ${getStepTitle(i)}</strong>`;
                } else {
                    label.innerHTML = `Step ${i}: ${getStepTitle(i)}`;
                }
            }
        }

        function getStepTitle(step) {
            switch(step) {
                case 1: return 'Service';
                case 2: return 'Room';
                case 3: return 'Schedule & Staff';
                case 4: return 'Pokémon Info';
                case 5: return 'Review & Confirm';
                default: return '';
            }
        }

        function goToStep(step) {
            if (step < 1 || step > totalSteps) return;

            if (step > currentStep) {
                if (currentStep === 1 && !validateStep1()) return;
                if (currentStep === 2 && !validateStep2()) return;
                if (currentStep === 3 && !validateStep3()) return;
                if (currentStep === 4 && !validateStep4()) return;
            }

            for (let i = 1; i <= totalSteps; i++) {
                const panel = document.getElementById(`panel${i}`);
                if (panel) {
                    panel.style.display = (i === step) ? 'block' : 'none';
                }
            }

            currentStep = step;
            updateStepIndicator(step);

            if (step === 2) {
                loadRoomsForService(selectedService.id);
            } else if (step === 3) {
                loadTimeSlots();
            } else if (step === 5) {
                renderSummary();
            }
        }

        // Category filter
        categoryFilter.addEventListener('change', function() {
            const selectedCat = this.value;
            document.querySelectorAll('.service-row').forEach(row => {
                if (selectedCat === 'all' || row.getAttribute('data-category') === selectedCat) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        });

        // Service Radio selection
        document.querySelectorAll('input[name="serviceRadio"]').forEach(radio => {
            radio.addEventListener('change', function() {
                if (this.checked) {
                    selectedService = {
                        id: parseInt(this.value),
                        name: this.getAttribute('data-name'),
                        price: parseFloat(this.getAttribute('data-price')),
                        duration: parseInt(this.getAttribute('data-duration')),
                        categoryName: this.getAttribute('data-categoryname')
                    };
                    selectedServiceIdInput.value = selectedService.id;
                    selectedRoom = null;
                    selectedRoomIdInput.value = '';
                    selectedSlot = null;
                }
            });
        });

        function validateStep1() {
            const checked = document.querySelector('input[name="serviceRadio"]:checked');
            if (!checked) {
                alert('Please select a service to proceed.');
                return false;
            }
            if (!selectedService) {
                selectedService = {
                    id: parseInt(checked.value),
                    name: checked.getAttribute('data-name'),
                    price: parseFloat(checked.getAttribute('data-price')),
                    duration: parseInt(checked.getAttribute('data-duration')),
                    categoryName: checked.getAttribute('data-categoryname')
                };
                selectedServiceIdInput.value = selectedService.id;
            }
            return true;
        }

        document.getElementById('btnNext1').addEventListener('click', () => goToStep(2));

        // Step 2: Load rooms
        function loadRoomsForService(serviceId) {
            const tbody = document.getElementById('roomTbody');
            const loading = document.getElementById('roomLoadingMsg');

            loading.style.display = 'block';
            tbody.innerHTML = '';

            fetch(`/Booking/GetRoomsByService?serviceId=${serviceId}`)
                .then(res => res.json())
                .then(rooms => {
                    loading.style.display = 'none';
                    if (!rooms || rooms.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="5">No available rooms under this service category.</td></tr>';
                        return;
                    }

                    rooms.forEach(room => {
                        const tr = document.createElement('tr');
                        const isChecked = selectedRoom && selectedRoom.id === room.id;
                        tr.innerHTML = `
                            <td>
                                <input type="radio" name="roomRadio" value="${room.id}"
                                       data-number="${room.roomNumber}"
                                       data-type="${room.roomTypeName}"
                                       data-price="${room.basePrice}"
                                       ${isChecked ? 'checked' : ''} />
                            </td>
                            <td>Room ${room.roomNumber}</td>
                            <td>${room.roomTypeName}</td>
                            <td>${room.description || 'Standard Room'}</td>
                            <td>+RM ${parseFloat(room.basePrice).toFixed(2)}</td>
                        `;
                        tbody.appendChild(tr);
                    });

                    document.querySelectorAll('input[name="roomRadio"]').forEach(radio => {
                        radio.addEventListener('change', function() {
                            if (this.checked) {
                                selectedRoom = {
                                    id: parseInt(this.value),
                                    number: this.getAttribute('data-number'),
                                    typeName: this.getAttribute('data-type'),
                                    basePrice: parseFloat(this.getAttribute('data-price'))
                                };
                                selectedRoomIdInput.value = selectedRoom.id;
                                selectedSlot = null;
                            }
                        });
                    });
                })
                .catch(() => {
                    loading.style.display = 'none';
                    tbody.innerHTML = '<tr><td colspan="5" style="color:red;">Error loading rooms.</td></tr>';
                });
        }

        function validateStep2() {
            const checked = document.querySelector('input[name="roomRadio"]:checked');
            if (!checked) {
                alert('Please select a room to proceed.');
                return false;
            }
            if (!selectedRoom) {
                selectedRoom = {
                    id: parseInt(checked.value),
                    number: checked.getAttribute('data-number'),
                    typeName: checked.getAttribute('data-type'),
                    basePrice: parseFloat(checked.getAttribute('data-price'))
                };
                selectedRoomIdInput.value = selectedRoom.id;
            }
            return true;
        }

        document.getElementById('btnPrev2').addEventListener('click', () => goToStep(1));
        document.getElementById('btnNext2').addEventListener('click', () => goToStep(3));

        // Step 3: Slots
        function loadTimeSlots() {
            if (!selectedService || !selectedRoom) return;

            const date = bookingDatePicker.value;
            const staffId = staffSelector.value;
            const container = document.getElementById('slotListContainer');
            const statusMsg = document.getElementById('slotStatusMsg');
            const notice = document.getElementById('selectedSlotNotice');

            statusMsg.textContent = 'Checking slot availability...';
            container.innerHTML = '';
            notice.style.display = 'none';

            fetch(`/Booking/GetAvailableTimeSlots?serviceId=${selectedService.id}&roomId=${selectedRoom.id}&staffId=${staffId || ''}&date=${date}`)
                .then(res => res.json())
                .then(slots => {
                    statusMsg.textContent = `${slots.filter(s => s.isAvailable).length} slot(s) available on ${date}.`;

                    if (!slots || slots.length === 0) {
                        container.innerHTML = '<div>No slots found.</div>';
                        return;
                    }

                    slots.forEach(slot => {
                        const slotDiv = document.createElement('div');
                        slotDiv.style.marginBottom = '4px';

                        if (slot.isAvailable) {
                            const isChecked = selectedSlot && selectedSlot.time === slot.time;
                            slotDiv.innerHTML = `
                                <label>
                                    <input type="radio" name="slotRadio" value="${slot.startTime}"
                                           data-time="${slot.time}" data-start="${slot.startTime}" data-end="${slot.endTime}"
                                           ${isChecked ? 'checked' : ''} />
                                    ${slot.time} (Available)
                                </label>
                            `;
                        } else {
                            slotDiv.innerHTML = `
                                <label style="color: gray;">
                                    <input type="radio" disabled />
                                    ${slot.time} - [Unavailable: ${slot.reason || 'Booked'}]
                                </label>
                            `;
                        }
                        container.appendChild(slotDiv);
                    });

                    document.querySelectorAll('input[name="slotRadio"]').forEach(radio => {
                        radio.addEventListener('change', function() {
                            if (this.checked) {
                                selectedSlot = {
                                    time: this.getAttribute('data-time'),
                                    startTime: this.getAttribute('data-start'),
                                    endTime: this.getAttribute('data-end')
                                };
                                selectedStartTimeInput.value = selectedSlot.startTime;

                                const startDt = new Date(selectedSlot.startTime);
                                const endDt = new Date(selectedSlot.endTime);
                                const timeStr = `${startDt.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})} - ${endDt.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}`;
                                document.getElementById('selectedSlotText').textContent = timeStr;
                                notice.style.display = 'block';
                            }
                        });
                    });
                })
                .catch(() => {
                    statusMsg.textContent = 'Error loading slots.';
                });
        }

        bookingDatePicker.addEventListener('change', loadTimeSlots);
        staffSelector.addEventListener('change', loadTimeSlots);

        function validateStep3() {
            const checked = document.querySelector('input[name="slotRadio"]:checked');
            if (!checked || !selectedStartTimeInput.value) {
                alert('Please select an available time slot.');
                return false;
            }
            return true;
        }

        document.getElementById('btnPrev3').addEventListener('click', () => goToStep(2));
        document.getElementById('btnNext3').addEventListener('click', () => goToStep(4));

        // Step 4: Pokemon details
        function validateStep4() {
            const name = pokemonNameInput.value.trim();
            if (!name) {
                alert('Please enter your Pokémon name.');
                pokemonNameInput.focus();
                return false;
            }
            return true;
        }

        document.getElementById('btnPrev4').addEventListener('click', () => goToStep(3));
        document.getElementById('btnNext4').addEventListener('click', () => goToStep(5));

        // Step 5: Summary
        function renderSummary() {
            document.getElementById('sumPokemonName').textContent = pokemonNameInput.value.trim() || 'N/A';
            document.getElementById('sumServiceName').textContent = selectedService ? `${selectedService.name} (${selectedService.categoryName})` : 'N/A';
            document.getElementById('sumDuration').textContent = selectedService ? `${selectedService.duration} minutes` : 'N/A';
            document.getElementById('sumRoomName').textContent = selectedRoom ? `Room ${selectedRoom.number} (${selectedRoom.typeName})` : 'N/A';

            const staffText = staffSelector.options[staffSelector.selectedIndex].text;
            document.getElementById('sumStaffName').textContent = staffText;

            const dateVal = bookingDatePicker.value;
            const slotText = document.getElementById('selectedSlotText').textContent;
            document.getElementById('sumSchedule').textContent = `${dateVal} (${slotText})`;

            document.getElementById('sumNotes').textContent = notesInput.value.trim() || 'None';

            const servicePrice = selectedService ? selectedService.price : 0;
            const roomPrice = selectedRoom ? selectedRoom.basePrice : 0;
            const totalPrice = servicePrice + roomPrice;

            document.getElementById('sumServicePrice').textContent = `RM ${servicePrice.toFixed(2)}`;
            document.getElementById('sumRoomPrice').textContent = `RM ${roomPrice.toFixed(2)}`;
            document.getElementById('sumTotalPrice').textContent = `RM ${totalPrice.toFixed(2)}`;
        }

        document.getElementById('btnPrev5').addEventListener('click', () => goToStep(4));

        document.getElementById('btnSubmitBooking').addEventListener('click', function(e) {
            if (!validateStep1() || !validateStep2() || !validateStep3() || !validateStep4()) {
                e.preventDefault();
                return;
            }
        });

        // Initialize checked service radio if any
        const initialRadio = document.querySelector('input[name="serviceRadio"]:checked');
        if (initialRadio) {
            initialRadio.dispatchEvent(new Event('change'));
        }
    </script>
}
