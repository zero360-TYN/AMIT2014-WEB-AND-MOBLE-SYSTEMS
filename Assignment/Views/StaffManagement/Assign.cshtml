@model TableListingViewModel
@{
    ViewBag.Title = "Assign";
}

<link rel="stylesheet" href="~/css/StaffManagement/Assign.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Assign New Staff
    </h2>
</div>

<p class="pk-welcome-text">Select a user account below to grant them staff privileges.</p>

<form asp-action="Assign" asp-controller="StaffManagement" method="post" id="assignForm">
    @Html.Partial("_TableList", Model)
</form>

<a asp-action="Index" class="pk-btn-outline">Back to Dashboard</a>

@section foot {
    <script>
        const form = document.getElementById('assignForm');
        const assignBtns = document.querySelectorAll('button[name="accountId"]');

        assignBtns.forEach(btn => {
            btn.addEventListener('click', function(event) {
                event.preventDefault();

                const accountIdValue = this.value;

                Swal.fire({
                    title: 'Confirm Assignment',
                    text: "Grant staff privileges to this user? This action cannot be undone.",
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--pk-blue-500)',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, assign staff role',
                    customClass: {
                        popup: 'pk-swal-modal'
                    }
                }).then((result) => {
                    if (result.isConfirmed) {
                        const submitInput = document.createElement('input');
                        submitInput.type = 'hidden';
                        submitInput.name = 'accountId';
                        submitInput.value = accountIdValue;

                        form.appendChild(submitInput);
                        form.submit();
                    }
                });
            });
        });
    </script>
}