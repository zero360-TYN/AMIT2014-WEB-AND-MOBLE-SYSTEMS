@model StaffEditViewModel

@{
    ViewBag.title = "Edit Staff";
}

<link rel="stylesheet" href="~/css/StaffManagement/Edit.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Edit Staff Profile
    </h2>
</div>

<div class="pk-form-panel">
    <form id="editStaffForm" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>

        <input type="hidden" asp-for="Id" />
        <!-- Hidden field to store the current avatar icon URL -->
        <input type="hidden" asp-for="AvatarIcon" />

        <div class="pk-form-group">
            <label asp-for="Username"></label>
            <input asp-for="Username" />
            <span asp-validation-for="Username" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div class="pk-form-group">
            <label>Avatar</label>
            @if (!string.IsNullOrEmpty(Model.AvatarIcon))
            {
                <div class="pk-avatar-preview">
                    <img src="@Model.AvatarIcon" alt="Avatar" width="60" height="60" />
                    <div>
                        <input type="checkbox" asp-for="RemoveAvatar" id="RemoveAvatar" />
                        <label for="RemoveAvatar">Delete current avatar</label>
                    </div>
                </div>
            }
            else
            {
                <div class="pk-avatar-preview" style="color: var(--pk-charcoal-light);">
                    <span>No avatar found.</span>
                </div>
            }
        </div>

        <div class="pk-form-group">
            <label asp-for="Status"></label>
            <select asp-for="Status" asp-items="Html.GetEnumSelectList<AccountStatusType>()">
                <option value="">-- Select Status --</option>
            </select>
            <span asp-validation-for="Status" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div class="pk-form-group" id="blockingReasonDiv" style="display: @(Model.Status == AccountStatusType.blocked ? "block" : "none");">
            <label asp-for="BlockingReason"></label>
            <input asp-for="BlockingReason" />
            <span asp-validation-for="BlockingReason" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>

        <div class="pk-actions-bar">
            <button id="saveBtn" type="submit" class="pk-btn-submit">Save Changes</button>
            <a asp-action="List" class="pk-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section foot{
    <script>
        const statusSelect = document.getElementById('Status');
        const form = document.getElementById('editStaffForm');
        const saveBtn = document.getElementById('saveBtn');
        const blockingReasonDiv = document.getElementById('blockingReasonDiv');
    
        const blockedValue = '@((int)AccountStatusType.blocked)';
        const deleteValue = '@((int)AccountStatusType.deleted)';
        let previousStatusValue = statusSelect.value;

        statusSelect.addEventListener('change', function () {
            if (this.value === deleteValue) {
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You are about to delete this staff account. This action cannot be undone.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: 'var(--pk-blue-500)',
                    confirmButtonText: 'Yes, delete it!',
                    customClass: { popup: 'pk-swal-modal' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    } else {
                        this.value = previousStatusValue;
                        if (previousStatusValue === blockedValue) {
                            blockingReasonDiv.style.display = 'block';
                        }
                    }
                });
                return;
            }

            if (this.value === blockedValue) {
                blockingReasonDiv.style.display = 'block';
            } else {
                blockingReasonDiv.style.display = 'none';
                const reasonInput = document.getElementById('BlockingReason');
                if (reasonInput) reasonInput.value = '';
            }

            previousStatusValue = this.value;
        });

        const currentFormData = new URLSearchParams(new FormData(form)).toString();
        saveBtn.addEventListener('click', function (event) {
            event.preventDefault();
            const newFormData = new URLSearchParams(new FormData(form)).toString();
            if (newFormData === currentFormData) {
                Swal.fire({
                    title: 'No changes to save',
                    text: "There are no modifications to apply.",
                    icon: 'info',
                    customClass: { popup: 'pk-swal-modal' }
                });
                return;
            }

            Swal.fire({
                title: 'Save Changes?',
                text: "Update this staff profile?",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--pk-blue-500)',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, save changes',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}