@model StaffDetailsViewModel

<div>
    <h1>Staff Profile</h1>
    
    <div>
        <img src="@Model.AvatarIcon" alt="Avatar" referrerpolicy="no-referrer" onerror="this.onerror=null;this.src='/images/user.png';" />
        <h2>@Model.Username</h2>
        <span>@Model.RoleName</span>
    </div>

    <table class="simple-table">
        <tbody>
            <tr>
                <th>Staff ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>
            <tr>
                <th>Account Status</th>
                <td>@Model.Status</td>
            </tr>
            @if (Model.Status == AccountStatusType.blocked)
            {
                <tr>
                    <th>Blocking Reason</th>
                    <td>@(Model.BlockingReason ?? "N/A")</td>
                </tr>
                <tr>
                    <th>Blocked By</th>
                    <td>@(Model.BlockBy ?? "System")</td>
                </tr>
            }
        </tbody>
    </table>
    <br />
    <a asp-action="List" class="btn btn-secondary">Back to List</a>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>

    <hr class="my-4" />

    <!-- Staff Schedule Timetable Section -->
    <div class="staff-schedule-section">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h3 class="m-0">Staff Schedule & Bookings</h3>
            <span class="text-muted">Total Handled Bookings: @Model.BookingEvents.Count</span>
        </div>

        <partial name="_VisualSlotTable" model='new VisualSlotTableConfig {
            Id = "staff_timetable_" + Model.Id,
            ViewType = SlotViewType.Week,
            IsReadOnly = true,
            StartDate = DateTime.Today,
            BusinessBeginsHour = 8,
            BusinessEndsHour = 20,
            CellDuration = 60,
            Events = Model.BookingEvents,
            OnEventClick = "showBookingDetailModal"
        }' />
    </div>
</div>

<partial name="_BookingDetailModal" />