@model Assignment.Models.BookingDetailsViewModel

@{
    ViewBag.Title = "Booking Details";
}

<link rel="stylesheet" href="~/css/BookingManagement/Details.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Booking Record #@Model.Id
    </h2>
</div>

<div class="pk-details-card">
    <table class="simple-table">
        <tbody>
            <tr>
                <th>Booking ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Customer</th>
                <td>@Model.CustomerName (@Model.CustomerEmail)</td>
            </tr>
            <tr>
                <th>Pokémon Name</th>
                <td><strong>@Model.PokemonName</strong></td>
            </tr>
            <tr>
                <th>Special Notes</th>
                <td>@(string.IsNullOrWhiteSpace(Model.Notes) ? "None" : Model.Notes)</td>
            </tr>
            <tr>
                <th>Service</th>
                <td>@Model.ServiceName (@Model.ServiceCategoryName)</td>
            </tr>
            <tr>
                <th>Room</th>
                <td>Room @Model.RoomNumber (@Model.RoomTypeName)</td>
            </tr>
            <tr>
                <th>Assigned Staff</th>
                <td>@Html.Raw(Model.StaffName)</td>
            </tr>
            <tr>
                <th>Start Time</th>
                <td>@Model.StartTime.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
            <tr>
                <th>End Time</th>
                <td>@Model.EndTime.ToString("yyyy-MM-dd HH:mm")</td>
            </tr>
            <tr>
                <th>Status</th>
                @{
                    string badgeColor = Model.Status == Assignment.Models.BookingStatus.confirmed ? "var(--pk-blue-500)" :
                                        Model.Status == Assignment.Models.BookingStatus.pending ? "#f59e0b" :
                                        Model.Status == Assignment.Models.BookingStatus.completed ? "#10b981" : "#ef4444";
                }
                <td><strong style="color: @badgeColor;">@Model.Status.ToString().ToUpper()</strong></td>
            </tr>
            <tr>
                <th>Total Price</th>
                <td><strong style="color: #10b981;">@Model.TotalPrice.ToString("C", new System.Globalization.CultureInfo("en-MY"))</strong></td>
            </tr>
            <tr>
                <th>Booked At</th>
                <td>@Model.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss")</td>
            </tr>
        </tbody>
    </table>
</div>

<div class="pk-actions-bottom">
    <a asp-action="List" class="pk-btn-outline">Back to List</a>
</div>
