@model Assignment.Models.RoomTypeCreateViewModel

@{
    ViewBag.Title = "Create Room Type";
}

<link rel="stylesheet" href="~/css/RoomManagement/Form.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Define New Room Type
    </h2>
</div>

<div class="pk-form-panel">
    <form id="createRoomTypeForm" asp-action="CreateRoomType" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>
        
        <div class="pk-form-group">
            <label asp-for="Name"></label>
            <input asp-for="Name" placeholder="e.g. Deluxe Suite" />
            <span asp-validation-for="Name" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" placeholder="Enter facilities and details..."></textarea>
            <span asp-validation-for="Description" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="BasePrice"></label>
            <input asp-for="BasePrice" type="number" step="0.01" />
            <span asp-validation-for="BasePrice" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="ServiceCategoryId"></label>
            <select asp-for="ServiceCategoryId" asp-items="ViewBag.ServiceCategories">
                <option value="">-- Select Service Category --</option>
            </select>
            <span asp-validation-for="ServiceCategoryId" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-actions-bar">
            <button id="createBtn" type="submit" class="pk-btn-submit">Create Type</button>
            <a asp-action="RoomTypeList" class="pk-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        const form = document.getElementById('createRoomTypeForm');
        const createBtn = document.getElementById('createBtn');

        createBtn.addEventListener('click', function(event) {
            event.preventDefault();
            if (!$(form).valid()) {
                return;
            }

            Swal.fire({
                title: 'Confirm Creation',
                text: "You are about to define a new room type.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--pk-blue-500)',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, create it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}