@model TableListingViewModel

@{
    ViewBag.Title = "Room Type List";
}

<link rel="stylesheet" href="~/css/RoomManagement/List.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Room Type Configurations
    </h2>
</div>

<div style="margin-bottom: 24px;">
    <partial name="_AjaxSearch" model='new AjaxSearchViewModel {
        Fields = new() {
            { nameof(RoomType.Id), "Room Type ID" },
            { nameof(RoomType.Name), "Name" },
            { nameof(RoomType.Description), "Description" },
            { nameof(RoomType.BasePrice), "Base Price" }
        }
    }' />
</div>

<div id="table-container">
    @Html.Partial("_TableList", Model)
</div>

<a asp-action="Index" class="pk-btn-outline">Back to Dashboard</a>