@model RoomTypeDetailsViewModel

@{
    ViewBag.Title = $"{Model.Name} - Room Type Details";
}

<link rel="stylesheet" href="~/css/RoomManagement/Details.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Room Type: @Model.Name
    </h2>
    <div>
        <a asp-action="RoomTypeList" class="pk-btn-outline">Back to Room Type List</a>
        <a asp-action="EditRoomType" asp-route-id="@Model.Id" class="pk-btn-primary">Edit Room Type</a>
    </div>
</div>

<div class="pk-details-card">
    <div class="pk-details-grid">
        <div class="pk-detail-item">
            <strong>Category</strong>
            <p>@Model.ServiceCategoryName</p>
        </div>
        <div class="pk-detail-item">
            <strong>Base Price</strong>
            <p style="color: #10b981;">@Model.BasePrice.ToString("C", new System.Globalization.CultureInfo("en-MY"))</p>
        </div>
        <div class="pk-detail-item">
            <strong>Total Active Rooms</strong>
            <p style="color: var(--pk-blue-600);">@Model.TotalRooms room(s)</p>
        </div>
        <div class="pk-detail-item">
            <strong>Description</strong>
            <p>@(string.IsNullOrWhiteSpace(Model.Description) ? "N/A" : Model.Description)</p>
        </div>
    </div>
</div>

<div class="pk-schedule-control">
    <h3>Daily Room Timetable</h3>
    <div class="pk-date-picker-wrap">
        <label for="roomTypeDateSelector">Go to Date:</label>
        <input type="date" id="roomTypeDateSelector" value="@Model.SelectedDate.ToString("yyyy-MM-dd")" />
    </div>
</div>

<div style="background: var(--pk-bg-white); padding: 20px; border-radius: 12px; border: var(--pk-border-soft); box-shadow: 0 4px 15px rgba(0,0,0,0.03);">
    @if (Model.Resources.Any())
    {
        <partial name="_VisualSlotTable" model='new VisualSlotTableConfig {
            Id = "roomtype_timetable_" + Model.Id,
            ViewType = SlotViewType.Resources,
            IsReadOnly = true,
            StartDate = Model.SelectedDate,
            BusinessBeginsHour = 8,
            BusinessEndsHour = 20,
            CellDuration = 60,
            Resources = Model.Resources,
            Events = Model.Events,
            OnEventClick = "showBookingDetailModal"
        }' />
    }
    else
    {
        <div style="color: var(--pk-charcoal-light); font-style: italic; padding: 20px 0;">
            No active rooms are currently assigned to this room type.
        </div>
    }
</div>

<partial name="_BookingDetailModal" />

<script>
    document.getElementById("roomTypeDateSelector")?.addEventListener("change", function () {
        const handle = window["slotTable_roomtype_timetable_@Model.Id"];
        if (handle && this.value) {
            handle.setDate(this.value);
        }
    });
</script>