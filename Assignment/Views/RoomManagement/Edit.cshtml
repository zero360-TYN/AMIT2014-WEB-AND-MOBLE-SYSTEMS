@model Assignment.Models.RoomEditViewModel

@{
    ViewBag.Title = "Edit Room";
}

<link rel="stylesheet" href="~/css/RoomManagement/Form.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Configure Room
    </h2>
</div>

<div class="pk-form-panel">
    <form id="editRoomForm" asp-action="Edit" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>
        <input type="hidden" asp-for="Id" />
        
        <div class="pk-form-group">
            <label asp-for="RoomNumber"></label>
            <input asp-for="RoomNumber" />
            <span asp-validation-for="RoomNumber" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="RoomTypeId"></label>
            <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypes">
                <option value="">-- Select Room Type --</option>
            </select>
            <span asp-validation-for="RoomTypeId" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-actions-bar">
            <button id="saveBtn" type="submit" class="pk-btn-submit">Save Changes</button>
            <a asp-action="List" class="pk-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        const form = document.getElementById('editRoomForm');
        const saveBtn = document.getElementById('saveBtn');
        const currentFormData = new URLSearchParams(new FormData(form)).toString();

        saveBtn.addEventListener('click', function(event) {
            event.preventDefault();
            if (!$(form).valid()) {
                return;
            }

            const newFormData = new URLSearchParams(new FormData(form)).toString();
            if (newFormData === currentFormData) {
                Swal.fire({
                    title: 'No changes',
                    text: "There are no changes to save.",
                    icon: 'info',
                    customClass: { popup: 'pk-swal-modal' }
                });
                return;
            }

            Swal.fire({
                title: 'Save Changes?',
                text: "You are about to save changes to this room.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--pk-blue-500)',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, save it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}