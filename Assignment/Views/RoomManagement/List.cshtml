@model TableListingViewModel

@{
    ViewBag.Title = "Room List";
}

<link rel="stylesheet" href="~/css/RoomManagement/List.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Room Roster
    </h2>
</div>

<div style="margin-bottom: 24px;">
    <partial name="_AjaxSearch" model='new AjaxSearchViewModel {
        Fields = new() {
            { nameof(Room.Id), "Room ID" },
            { nameof(Room.RoomNumber), "Room Number" },
            { $"{nameof(Room.RoomType)}.{nameof(RoomType.Name)}", "Room Type" }
        }
    }' />
</div>

<div id="table-container">
    @Html.Partial("_TableList", Model)
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" id="deleteRoomId" />
</form>

<a asp-action="Index" class="pk-btn-outline">Back to Dashboard</a>

@section foot {
    <script>
        const deleteForm = document.getElementById('deleteForm');
        const deleteRoomId = document.getElementById('deleteRoomId');

        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-delete');
            if (!btn) return;

            e.preventDefault();
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');

            Swal.fire({
                title: 'Confirm Deletion',
                text: "You are about to delete Room " + name + ". This action cannot be undone.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: 'var(--pk-blue-500)',
                confirmButtonText: 'Yes, delete it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    deleteRoomId.value = id;
                    deleteForm.submit();
                }
            });
        });
    </script>
}