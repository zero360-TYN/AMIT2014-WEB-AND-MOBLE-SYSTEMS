@model Assignment.Models.RoomDetailsViewModel

@{
    ViewBag.Title = "Room Details";
}

<link rel="stylesheet" href="~/css/RoomManagement/Details.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Room Details
    </h2>
</div>

<div class="pk-details-card">
    <table class="simple-table">
        <tbody>
            <tr>
                <th>Room ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Room Number</th>
                <td><strong>@Model.RoomNumber</strong></td>
            </tr>
            <tr>
                <th>Room Type</th>
                <td><span style="color: var(--pk-blue-600); font-weight: 600;">@Model.RoomTypeName</span></td>
            </tr>
            <tr>
                <th>Base Price</th>
                <td><strong style="color: #10b981;">@Model.BasePrice.ToString("C", new System.Globalization.CultureInfo("en-MY"))</strong></td>
            </tr>
        </tbody>
    </table>
    
    <div class="pk-actions-bar">
        <a asp-action="List" class="pk-btn-outline">Back to list</a>
        <a asp-action="Edit" asp-route-id="@Model.Id" class="pk-btn-primary">Edit Room</a>
        <button type="button" id="deleteBtn" class="pk-btn-danger">Delete Room</button>
    </div>
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" value="@Model.Id" />
</form>

@section foot {
    <script>
        const deleteBtn = document.getElementById('deleteBtn');
        const deleteForm = document.getElementById('deleteForm');

        if (deleteBtn) {
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Confirm Deletion',
                    text: "You are about to delete Room @Model.RoomNumber. This action cannot be undone.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: 'var(--pk-blue-500)',
                    confirmButtonText: 'Yes, delete it!',
                    customClass: { popup: 'pk-swal-modal' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        deleteForm.submit();
                    }
                });
            });
        }
    </script>
}