@model Assignment.Models.RoomDetailsViewModel

@{
    ViewBag.Title = "Room Details";
}

<h2>Room Details</h2>

<div>
    <hr />
    <table class="simple-table">
        <tbody>
            <tr>
                <th>Room ID</th>
                <td>@Model.Id</td>
            </tr>
            <tr>
                <th>Room Number</th>
                <td>@Model.RoomNumber</td>
            </tr>
            <tr>
                <th>Room Type</th>
                <td>@Model.RoomTypeName</td>
            </tr>
            <tr>
                <th>Base Price</th>
                <td>@Model.BasePrice.ToString("C", new System.Globalization.CultureInfo("en-MY"))</td>
            </tr>
        </tbody>
    </table>
    <br />
    <a asp-action="Edit" asp-route-id="@Model.Id">Edit</a> |
    <button type="button" id="deleteBtn">Delete</button> |
    <a asp-action="List">Back to list</a>
</div>

<form id="deleteForm" asp-action="Delete" method="post" style="display:none;">
    <input type="hidden" name="id" value="@Model.Id" />
</form>

@section foot {
    <script>
        const deleteBtn = document.getElementById('deleteBtn');
        const deleteForm = document.getElementById('deleteForm');

        if (deleteBtn) {
            deleteBtn.addEventListener('click', function(e) {
                e.preventDefault();
                Swal.fire({
                    title: 'Are you sure?',
                    text: "You are about to delete Room @Model.RoomNumber. This action cannot be undone.",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        deleteForm.submit();
                    }
                });
            });
        }
    </script>
}
