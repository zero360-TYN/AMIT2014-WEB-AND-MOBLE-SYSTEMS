@model Assignment.Models.RoomCreateViewModel

@{
    ViewBag.Title = "Create Room";
}

<link rel="stylesheet" href="~/css/RoomManagement/Form.css" asp-append-version="true" />

<div class="pk-page-header">
    <h2 class="pk-dashboard-title">
        Deploy New Room
    </h2>
</div>

<div class="pk-form-panel">
    <form id="createRoomForm" asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" style="color: #ef4444; margin-bottom: 16px;"></div>
        
        <div class="pk-form-group">
            <label asp-for="RoomNumber"></label>
            <input asp-for="RoomNumber" placeholder="e.g. A-101" />
            <span asp-validation-for="RoomNumber" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-form-group">
            <label asp-for="RoomTypeId"></label>
            <select asp-for="RoomTypeId" asp-items="ViewBag.RoomTypes">
                <option value="">-- Select Room Type --</option>
            </select>
            <span asp-validation-for="RoomTypeId" style="color: #ef4444; font-size: 0.85rem;"></span>
        </div>
        
        <div class="pk-actions-bar">
            <button id="createBtn" type="submit" class="pk-btn-submit">Deploy Room</button>
            <a asp-action="List" class="pk-btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section foot {
    <script>
        const form = document.getElementById('createRoomForm');
        const createBtn = document.getElementById('createBtn');

        createBtn.addEventListener('click', function(event) {
            event.preventDefault();
            if (!$(form).valid()) {
                return;
            }

            Swal.fire({
                title: 'Confirm Deployment',
                text: "You are about to create a new room.",
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: 'var(--pk-blue-500)',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Yes, create it!',
                customClass: { popup: 'pk-swal-modal' }
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    </script>
}