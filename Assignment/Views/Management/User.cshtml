@using Assignment.Helpers
@model List<UserVM>;

@{
    Layout = "_Layout";
    ViewBag.Title = "User Management";
} 

@Html.Button("Export", id: "exportUser")

<div class="roleFilter">
    <select id="role" class="role">
        <option value="">All Roles</option>
        <option value="admin">Admin</option>
        <option value="staff">Staff</option>
        <option value="user">User</option>
    </select>
</div>
<div>
    <form asp-controller="Management" asp-action="SearchUser" method="post">
        @Html.Input(type: "search", placeholder: "Search", aspfor: "Username")  
        @Html.Button("Go", type: "submit")
    </form>
</div>

<p>All Users： @Model.Count</p>
<div>
    <table>
        <thead>
            <tr>
                <th>Email</th>
                <th>Role</th>
                <th>Username</th>
                <th>Joined Date</th>
                <th>Status</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var detail in Model)
            {
                <tr>
                    <td>@detail.Email</td>
                    <td>
                        @switch (detail.accountDetail.RoleId)
                        {
                            case 1:
                                @:Staff
                                break;
                            case 2:
                                @:User
                                break;
                            case 3:
                                @:Admin
                                break;
                            default:
                                @:Unknown
                                break;
                        }
                    </td>
                    <td>@detail.accountDetail.Username</td>
                    <td>@detail.accountDetail.CreatedAt</td>
                    <td>Active</td>
                    <td>
                        @Html.Button("Block")
                    </td>
                </tr>
            }
        </tbody>

    </table>

</div>




