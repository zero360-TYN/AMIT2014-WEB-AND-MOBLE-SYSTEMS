@using Assignment.Helpers


@{
    Layout = "_AuthLayout";
    ViewBag.Title = "Reset Password";
    ViewBag.Css = "/css/account.css";
}

<div class="resetpassword-page">
    <div class="resetpassword-description">
        <h1>Find your account</h1>
        <p>Enter your email address to find your account.</p>
    </div>

    <form asp-controller="Account" asp-action="Reset_Password" method="post" class="resetpassword-container">
        <div class="resetpassword-getcode">
            @Html.Input(type: "email", placeholder: "Email Address", id: "forget-password", maxlength: "30")
            @Html.Button("Get Code", type: "button", id: "resetpassword-code")
        </div>
        @Html.Input(type: "text", placeholder: "Verification Code", id: "verification-code", maxlength: "6")
        @Html.Button("Continue", type: "button", id: "resetpassword-btn")
    </form>

</div>
