@{
    Layout = "_AuthLayout";
    ViewBag.Title = "Reset Password";
}
 
<h1>Find your account</h1>
<p>Enter your email address to find your account.</p>

<input placeholder="Email address" id="forgetpassword" class="forgetpassword" type="email" />
<button type="button">Get Code</button><br>
<input placeholder="Verification Code" id="verificationcode" class="verificationcode" type="text" /><br>
<button type="button">Continue</button>