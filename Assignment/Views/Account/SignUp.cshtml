@using Assignment.Helpers;
@model SignUpVM;

@{
    Layout = "_AuthLayout";
    ViewBag.Title = "Sign Up";
    ViewBag.Css = "/css/account.css";
}

<div class="signup-page">
    <div class="signup-description">
        <h2>Hi! <br>Please enter your personal <br>details to start your <br>journey with us!</h2>
        <p id="to-login">Already have an account? <a class="login-link" href="/Account/Login">Login</a></p>
    </div>

    <div class="signup-container">
        <h1>Create an Account</h1>
        <form asp-controller="Account" asp-action="SignUp" method="post" class="signup-input">
            @Html.Input(type: "email", id: "signupEmail", placeholder: "Email Address", aspfor: "Email")
            <span asp-validation-for="Email" class="text-danger"></span>

            @Html.Input(type: "text", id: "signupUsername", placeholder: "Username", aspfor: "Username")
            <span asp-validation-for="Username" class="text-danger"></span>

            @Html.Input(type: "password", id: "signupPassword", placeholder: "Password", aspfor: "Password")
            <span asp-validation-for="Password" class="text-danger"></span>

            @Html.Input(type: "password", id: "signupConfirmPassword", placeholder: "Confirm Password", aspfor: "ConfirmPassword")
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            @if (ViewBag.ErrorMessage != null)
            {
                <span class="text-danger">@ViewBag.ErrorMessage</span>
            }

            @Html.Button("Sign Up", type: "submit", id: "signup-btn")
        </form>
    </div>

</div>




