@using Assignment.Helpers;
@model SignUpVM;

@{
    Layout = "_AuthLayout";
    ViewBag.Title = "Sign Up"; 
}
<h2>Hi!</h2>
<h3>Please enter your personal <br> details to start your <br>journey with us!</h3>
<p>Do you already have an account? <a href="/Account/Login">Login</a></p>

<h1>Create an Account</h1>
<form asp-action="SignUp" method="post">
    @Html.Input(type: "email", id: "signupEmail", placeholder: "Email Address", aspfor: "Email") 
    <span asp-validation-for="Email" class="text-danger"></span><br>

    @Html.Input(type: "text", id: "signupUsername", placeholder: "Username", aspfor: "Username") 
    <span asp-validation-for="Username" class="text-danger"></span><br>

    @Html.Input(type: "password", id: "signupPassword", placeholder: "Password", aspfor: "Password") 
    <span asp-validation-for="Password" class="text-danger"></span><br>

    @Html.Input(type: "password", id: "signupConfirmPassword", placeholder: "Confirm Password", aspfor: "ConfirmPassword") 
    <span asp-validation-for="ConfirmPassword" class="text-danger"></span><br>
    @if (ViewBag.ErrorMessage != null)
        {
            <span class="text-danger">@ViewBag.ErrorMessage</span><br>
        }  

    @Html.Button("Sign Up", type: "submit")
</form>



